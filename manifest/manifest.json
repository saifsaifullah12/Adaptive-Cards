{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.1",
  "id": "e93f7b21-4d89-4a90-8c9f-35da124e7c19",
  "packageName": "com.platform4x.adaptivecards.v2",
  "developer": {
    "name": "Platform4x",
    "websiteUrl": "https://adaptive-cards-client.pages.dev",
    "privacyUrl": "https://adaptive-cards-client.pages.dev/privacy",
    "termsOfUseUrl": "https://adaptive-cards-client.pages.dev/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Platform4x Approvals",
    "full": "Platform4x Adaptive Cards & Approvals Bot"
  },
  "description": {
    "short": "Interactive Adaptive Cards for Platform4x leave requests and workflows",
    "full": "Send, view and approve Platform4x leave workflows, expense claims and actionable notifications directly inside Microsoft Teams and Outlook."
  },
  "accentColor": "#4F46E5",
  "bots": [
    {
      "botId": "67127d20-25a1-4da1-9778-2d9040e6fcb5",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "composeExtensions": [
    {
      "botId": "67127d20-25a1-4da1-9778-2d9040e6fcb5",
      "canUpdateConfiguration": false,
      "commands": [
        {
          "id": "searchWorkflows",
          "type": "query",
          "title": "Search Platform4x",
          "description": "Find and insert Platform4x workflow approval cards",
          "initialRun": true,
          "context": [
            "compose",
            "commandBox",
            "message"
          ],
          "parameters": [
            {
              "name": "query",
              "title": "Workflow Name or ID",
              "description": "Enter employee name, request ID or leave type",
              "inputType": "text"
            }
          ]
        }
      ],
      "messageHandlers": [
        {
          "type": "link",
          "value": {
            "domains": [
              "adaptive-cards-api.faaztech-teams.workers.dev",
              "platform4x.com",
              "*.platform4x.com",
              "adaptive-cards-client.pages.dev"
            ]
          }
        }
      ]
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "adaptive-cards-api.faaztech-teams.workers.dev",
    "adaptive-cards-client.pages.dev",
    "platform4x.com",
    "*.platform4x.com"
  ]
}
