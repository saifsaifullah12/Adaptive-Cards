# Microsoft App Credentials (Do not put real secrets in this template)
MicrosoftAppId=your-bot-id-guid
MicrosoftAppPassword=your-bot-secret
MicrosoftAppType=MultiTenant
MicrosoftAppTenantId=your-tenant-id-guid

# Target Email for Outlook Actionable Messages
TARGET_EMAIL=user@yourdomain.com

# Bot Endpoint & Host Configuration
NGROK_HOST=https://your-domain.ngrok-free.dev
NGROK_DOMAIN=your-domain.ngrok-free.dev
PORT=5000

# App & Manifest Identifiers
TEAMS_APP_ID=your-manifest-id-guid
BOT_ID=your-bot-id-guid
PACKAGE_NAME=com.platform4x.adaptivecards.v2
APP_NAME_SHORT=Platform4x Approvals
APP_NAME_FULL=Platform4x Adaptive Cards & Approvals Bot
PLATFORM_DOMAIN=platform4x.com
DEVELOPER_NAME=Platform4x
DEVELOPER_WEBSITE=https://platform4x.com
